model TicketMaster {
  id                String @id @default(cuid())

  orderId           String @unique

  purchaserUserId   String
  eventId           String

  ticketTypeId      String

  totalQty          Int
  remainingQty      Int

  createdAt         DateTime @default(now())

  order             Order @relation(fields: [orderId], references: [id])
  ticketType      EventTicketType @relation(fields: [ticketTypeId], references: [id])
  
  tickets     Ticket[]
}

model  Ticket {
    id                  String      @id   @default(cuid())
    masterId            String
    code                String      @unique
    email               String      @unique
    assignedUserId      String
    status              Status      @default(ISSUED)
    createdAt           DateTime    @default(now())

    ticketMaster        TicketMaster @relation(fields: [masterId], references: [id])
    user                User         @relation(fields: [assignedUserId], references: [id]) 
    registrations       Registration[] 
}       

model EventTicketType {
  id          String   @id @default(cuid())

  eventId     String

  name        String
  description String?

  price       Int
  quantity    Int
  sold        Int @default(0)
  reserved    Int @default(0)

  createdAt   DateTime @default(now())

  //Relations
  event Event @relation(fields: [eventId], references: [id])
  ticketsMaster TicketMaster[]
  orderItem         OrderItem[]
}

enum Status {
    ISSUED
    USED
    CANCELLED
}